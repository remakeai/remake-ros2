<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>remakeai</name>
  <version>0.1.0</version>
  <description>ROS2 client for Remake.ai apps platform</description>
  <maintainer email="iliao@.ai">Ilia O.</maintainer>
  <license>Apache 2.0</license>
  <url type="website">https://remake.ai</url>
  <url type="repository">https://github.com/remakeai/remakeai_ros2</url>
  <url type="bugtracker">https://github.com/remakeai/remakeai_ros2/issues</url>
  <author email="iliao@remake.ai">Ilia O.</author>

  <depend>rclpy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
